{
  "name": "thepill",
  "productName": "The Pill",
  "version": "0.1.0",
  "description": "A tiny always-on-top Claude pill that can see your screen. Click it and it becomes your real claude.ai chat.",
  "main": "src/main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "e2e": "electron --no-sandbox test/e2e-main.js && electron --no-sandbox test/shadow-e2e.js",
    "icons": "python3 scripts/make-icons.py",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "test": "node test/shadow-unit.js"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.thepill.desktop",
    "productName": "The Pill",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "The Pill",
        "schemes": [
          "thepill"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.png",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "The Pill lets Claude see your screen, only while you have watching turned on or press Share screen.",
        "NSMicrophoneUsageDescription": "Used only if you use Claude's voice mode.",
        "NSAppleEventsUsageDescription": "Shadow mode reads which app and browser tab is in front, only while you have it turned on."
      },
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Harvey Leech"
    },
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "artifactName": "The-Pill-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "author": {
    "name": "Harvey Leech"
  },
  "homepage": "https://github.com/harveyml31/Thepill"
}
